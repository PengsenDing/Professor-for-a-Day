{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "apps/api/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "apps/api", "--reload", "--port", "8787"],
      "port": 8787
    }
  ]
}

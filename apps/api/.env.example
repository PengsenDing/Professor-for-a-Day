# Copy to apps/api/.env and fill in the real keys. Never commit .env.
# Every name here maps to a field in app/config.py (case-insensitive).

# Required. The backend refuses to start without it.
DEUTSCHLANDGPT_API_KEY=replace-with-your-api-key

# Model used when a request does not send its own "model" field. A gpt-5-family
# model is expected: the Judge/Student reasoning-effort settings below are only
# valid for those models.
DEUTSCHLANDGPT_MODEL=gpt-5.5

# OpenAI-compatible base URL; LangChain appends /chat/completions.
DEUTSCHLANDGPT_BASE_URL=https://apiv2.deutschlandgpt.de/platform-api/api/v2

# Required. ElevenLabs speech provider; startup fails without the key (AC-CFG-2).
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-key

# Voices are fixed server-side; no request can override them. Each AI Student
# mode speaks with its own character, and ELEVENLABS_VOICE_ID is the fallback
# for anything else (defaults: Rachel / Adam / Daniel from the premade library).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_BEGINNER=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_CONFIDENT=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID_SKEPTIC=onwK4e9ZLuTAKqWW03F9

# Speech-to-text and text-to-speech model ids.
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Upstream speech request timeout in seconds.
ELEVENLABS_TIMEOUT_SECONDS=30

# Transcription uploads larger than this are rejected with 413 before any provider call.
TRANSCRIPTION_MAX_BYTES=15000000

# Local dev server port and the single browser origin allowed by CORS
# (the Next.js dev server in apps/web).
PORT=8787
WEB_ORIGIN=http://localhost:3000

# Sampling temperature (0.0-2.0) and upstream request timeout in seconds.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# Role temperatures: the Judge classifies against closed id sets so it runs cold;
# the AI Student only phrases a directive, so sampling variety is safe there.
JUDGE_TEMPERATURE=0.0
STUDENT_TEMPERATURE=0.7

# Role reasoning depth on gpt-5-family models (none/low/medium/high/xhigh): the
# Judge weighs cumulative evidence so it gets room to think; the Student only
# phrases a directive, so shallow reasoning keeps replies fast and cheap.
JUDGE_REASONING_EFFORT=medium
STUDENT_REASONING_EFFORT=low

# The hint coach sees only learner-visible conversation text and phrases one
# short teaching nudge — warm and shallow like the Student.
HINT_TEMPERATURE=0.5
HINT_REASONING_EFFORT=low

# MongoDB. Start a local one with:
#   docker compose -f infrastructure/docker-compose.yml up -d
# The API still boots when Mongo is unreachable: /health reports
# "database": "down" and the /api/sessions routes answer 503.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=professor_for_a_day
MONGODB_TIMEOUT_MS=5000

LOG_LEVEL=INFO
